generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hash — never returned in API responses
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitors      Monitor[]
  incidents     Incident[]
  notifications Notification[]

  @@index([email])
}

// ─── Monitors ────────────────────────────────────────────────────────────────

enum MonitorStatus {
  UNKNOWN // Not yet checked
  UP      // Last check succeeded
  DOWN    // At least 3 consecutive failures
}

model Monitor {
  id                   String        @id @default(cuid())
  userId               String
  name                 String
  url                  String
  method               String        @default("GET")
  intervalSeconds      Int           @default(60)    // polling interval
  timeoutSeconds       Int           @default(10)    // per-request timeout
  expectedCodes        Int[]         @default([200]) // acceptable HTTP status codes
  enabled              Boolean       @default(true)

  // ── Health state ───────────────────────────────────────────────────────────
  // Managed exclusively by the monitoring worker — not settable via API.
  status               MonitorStatus @default(UNKNOWN)
  consecutiveFailures  Int           @default(0)     // reset to 0 on success
  consecutiveSuccesses Int           @default(0)     // reset to 0 on failure
  lastCheckedAt        DateTime?
  lastResponseTimeMs   Int?                          // null until first check

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkResults         CheckResult[]
  incidents            Incident[]
  notifications        Notification[]

  @@index([userId])
  @@index([enabled])
  @@index([status])
  @@index([userId, enabled])    // composite for worker queries
}

// ─── Check Results ────────────────────────────────────────────────────────────
// One row per monitoring check. Used for history, stats, and charts.

model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String
  userId         String   // denormalized for efficient per-user queries

  // ── Outcome ────────────────────────────────────────────────────────────────
  success        Boolean
  statusCode     Int?     // null on network-level failures (timeout, DNS error)
  responseTimeMs Int?     // null on failures where no response was received
  errorCode      String?  // normalized error code: TIMEOUT, DNS_ERROR, etc.
  errorMessage   String?  // populated on failure; null on success

  checkedAt      DateTime @default(now())

  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([monitorId, checkedAt])            // for history queries ordered by time
  @@index([monitorId, success, checkedAt])   // for filtered history queries
  @@index([userId, checkedAt])               // for cross-monitor analytics
}

// ─── Incidents ────────────────────────────────────────────────────────────────
// Created when a monitor transitions to DOWN (outage started).
// Resolved when the monitor transitions back to UP (outage resolved).

enum IncidentStatus {
  OPEN
  RESOLVED
}

model Incident {
  id              String         @id @default(cuid())
  monitorId       String
  userId          String         // denormalized for efficient per-user queries

  status          IncidentStatus @default(OPEN)
  cause           String?        // error message or description of failure
  errorCode       String?        // machine-readable error code: TIMEOUT, HTTP_ERROR, etc.
  statusCode      Int?           // HTTP status code if available (e.g. 500, 502)

  startedAt       DateTime       @default(now())
  resolvedAt      DateTime?      // null while outage is ongoing
  durationSeconds Int?           // null while ongoing, computed in seconds upon resolution

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  monitor         Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   Notification[]

  @@index([monitorId])
  @@index([userId])
  @@index([status])
  @@index([monitorId, status])
  @@index([monitorId, startedAt])
  @@index([userId, startedAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────
// Records notification dispatch attempts and outcomes for state change events.

enum NotificationEvent {
  MONITOR_DOWN
  MONITOR_RECOVERED
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
}

enum NotificationChannel {
  EMAIL
  WEBHOOK
}

model Notification {
  id              String              @id @default(cuid())
  userId          String
  monitorId       String
  incidentId      String?

  event           NotificationEvent
  channel         NotificationChannel @default(EMAIL)
  recipient       String              // target email address or webhook URL
  subject         String?
  body            String?

  status          NotificationStatus  @default(PENDING)
  error           String?             // failure detail if delivery fails
  attempts        Int                 @default(0)
  sentAt          DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor         Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  incident        Incident?           @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([monitorId])
  @@index([incidentId])
  @@index([status])
  @@index([createdAt])
}


