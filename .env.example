# ── PulseWatch — environment variable template ────────────────────────────
# Copy to .env and fill in the values before starting with docker compose.
#
# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch_local_dev
POSTGRES_DB=pulsewatch
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3000
LOG_LEVEL=info
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80
